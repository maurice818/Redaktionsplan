# =============================================================================
# MEET GERMANY Redaktionszentrale – Umgebungsvariablen (Vorlage)
# Kopieren nach .env.local (lokal) bzw. in Vercel → Settings → Environment Variables.
# Niemals echte Werte in dieses Repository einchecken.
# =============================================================================

# --- Öffentlich (landen im Browser-Bundle) ---------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
# Publishable Key (sb_publishable_…). Ältere Projekte: stattdessen NEXT_PUBLIC_SUPABASE_ANON_KEY setzen.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Öffentliche Basis-URL der App (für Kundenlinks und E-Mails), ohne Schrägstrich am Ende
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Nur serverseitig ---------------------------------------------------------
# Secret Key (sb_secret_…) bzw. service_role key. Umgeht RLS – nur Server/Cron.
SUPABASE_SECRET_KEY=
# 32 Byte Base64 – verschlüsselt Plattform-Tokens und Kundenlinks (npm run secrets:generate)
APP_ENCRYPTION_KEY=
# Schützt /api/cron/tick – Vercel sendet ihn automatisch als Bearer-Token (npm run secrets:generate)
CRON_SECRET=

# --- E-Mail (Resend) – optional, ohne Werte wird nur protokolliert --------------
RESEND_API_KEY=
# Verifizierte Absenderdomain in Resend, z. B. "MEET GERMANY Redaktion <redaktion@meet-germany.network>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Meta (Facebook-Seite & Instagram) – optional -------------------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0

# --- LinkedIn (Community Management API) – optional -----------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Linkedin-Version-Header (YYYYMM), mindestens jährlich aktualisieren
LINKEDIN_API_VERSION=202609
